# Production Environment Variables for Render
# Edit these values with your actual production credentials

# Database Configuration (Render will provide this automatically)
DATABASE_URL=postgresql://username:password@host:port/database_name

# Google OAuth Configuration (Update with your production domain)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=https://your-backend-domain.onrender.com/auth/google/callback

# Frontend URL (Update with your Vercel domain)
FRONTEND_URL=https://your-frontend-domain.vercel.app

# User Limit Configuration
MAX_FREE_USERS=20

# Email Configuration (if using SMTP)
EMAIL_USER=ywork.parry@gmail.com
EMAIL_PASSWORD=veprhckdygvlzdzp
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587

# Flask Configuration
FLASK_ENV=production
SECRET_KEY=Howareyou@11
